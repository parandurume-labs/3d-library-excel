# Server-authoritative source: "demo" or "graph".
# Graph failures never fall back to the local demo.
DATA_MODE=demo
# Browser display hint only. This is not trusted by the server.
NEXT_PUBLIC_DATA_MODE=demo

# Use the exact public origin. The callback path is:
# http://localhost:3000/api/auth/callback/azure-ad
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Microsoft Entra application registration (server-only):
# Application (client) ID, client secret Value, and Directory (tenant) ID.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Use "common" only when the app registration supports the intended account types.
AZURE_AD_TENANT_ID=common

# Discover with:
# GET https://graph.microsoft.com/v1.0/me/drive/root:/3d-library/3d-library-demo.xlsx
# parentReference.driveId -> GRAPH_DRIVE_ID
# id -> GRAPH_WORKBOOK_ITEM_ID
# The signed-in delegated identity must be able to read and write this workbook.
GRAPH_DRIVE_ID=
GRAPH_WORKBOOK_ITEM_ID=
